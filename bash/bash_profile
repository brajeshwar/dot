# Bash Profile
# Edited: Mar 15, 2026
[ -f "$HOME/.paths" ] && . "$HOME/.paths"

# rbenv (bash only)
if command -v rbenv >/dev/null; then
  eval "$(rbenv init - bash)"
fi

# GPG
export GPG_TTY=$(tty)

# Login bash reads this file, not ~/.bashrc — pull it in so interactive
# login shells still get completion and the rest of the interactive setup.
if [ -f "$HOME/.bashrc" ]; then . "$HOME/.bashrc"; fi

. "$HOME/.cargo/env"
